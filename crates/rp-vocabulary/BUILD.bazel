load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The crate's `[lints]` table (inherited from `[workspace.lints]`), read from
# Cargo.toml so Cargo and Bazel enforce one lint set. Every Rust target below
# names it as `lint_config`: rustc applies its rustc lints, and the clippy
# aspect (`--config=clippy`, see .bazelrc) its clippy deny set.
extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# `rp` activates the `schema` feature (`services/rp/Cargo.toml`:
# `rp-vocabulary = { features = ["schema"] }`), so after the repin
# crate_universe resolves schemars into this target's "normal" bucket
# (`all_crate_deps(normal = True)` picks it up). Unlike Cargo, Bazel does
# NOT infer a first-party crate's feature activation from a consumer's
# Cargo.toml, so `crate_features = ["schema"]` is set explicitly below to
# turn on the `#[cfg(feature = "schema")]` JsonSchema derives.
rust_library(
    name = "rp-vocabulary",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["schema"],
    crate_name = "rp_vocabulary",
    edition = "2021",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "rp-vocabulary_unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":rp-vocabulary",
    crate_features = ["schema"],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
