load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The crate's `[lints]` table (inherited from `[workspace.lints]`), read from
# Cargo.toml so Cargo and Bazel enforce one lint set. Every Rust target below
# names it as `lint_config`: rustc applies its rustc lints, and the clippy
# aspect (`--config=clippy`, see .bazelrc) its clippy deny set.
extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "rusty-photon-i18n",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "rusty_photon_i18n",
    edition = "2021",
    lint_config = ":lints",
    proc_macro_deps = ["//crates/rusty-photon-i18n-derive:rusty-photon-i18n-derive"] + all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "rusty-photon-i18n_unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":rusty-photon-i18n",
    lint_config = ":lints",
    proc_macro_deps = ["//crates/rusty-photon-i18n-derive:rusty-photon-i18n-derive"] + all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
