load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Hand-written SVBony SDK FFI bindings (no bindgen — `lib.rs` is a
# hand-written `extern "C"` block, mirroring `libqhyccd-sys`'s shape:
# SVBony's SDK header carries no license text anywhere, so it is not
# vendored/bindgen'd here, only hand-transcribed — see lib.rs's crate docs).
#
# `build.rs` emits the per-OS native link directives (dylib=SVBCameraSDK +
# dylib=usb-1.0 on Linux/macOS; dylib=SVBCameraSDK alone on Windows, whose
# DLL drives the camera through the in-box WinUSB). `links = "SVBCameraSDK"`
# lets Bazel coordinate the native link the same way the Cargo `links` key
# does.
#
# DEVIATION from libqhyccd-sys/libzwo-sys's BUILD.bazel: those bake in a real
# link against the system-installed SDK (this workspace's Bazel CI/dev hosts
# have QHYCCD/ZWO pre-provisioned).
#
# The Cargo workflows provision the real SDK with
# `.github/actions/install-svbony-sdk`, a GitHub Actions action that Bazel's
# hermetic build graph does not consume; Bazel would need its own repository
# rule (e.g. an `http_file` fetch + a non-skipping build-script variant) to
# provision the same SDK, and nothing in `MODULE.bazel` does. So
# `build_script_env` below bakes `SVBONY_SKIP_NATIVE_LINK=1` into the build
# script unconditionally: the default Bazel build (and `svbony-rs_unit_test`,
# which needs a real final link) works with zero SVBony SDK provisioning, and
# no Bazel target links the real SDK — which is why the real
# `:svbony-camera` binary is tagged `manual` (docs/services/svbony-camera.md
# "Bazel links the simulation only"). A Bazel-side SDK-fetch rule would let
# the env go.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "SVBONY_SKIP_NATIVE_LINK": "1",
    },
    edition = "2021",
    links = "SVBCameraSDK",
    visibility = ["//visibility:private"],
)

rust_library(
    name = "libsvbony-sys",
    srcs = ["lib.rs"],
    crate_name = "libsvbony_sys",
    crate_root = "lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [":build_script"],
)

# The files the tools crate's bare-reference guard reads
# (tools/rusty-photon-ci/src/bare_refs.rs).
filegroup(
    name = "sources",
    srcs = glob(
        [
            "**/*.rs",
            "**/*.feature",
            "**/*.toml",
            "**/*.bzl",
            "**/*.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)
