load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The crate's `[lints]` table (inherited from `[workspace.lints]`), read from
# Cargo.toml so Cargo and Bazel enforce one lint set. Every Rust target below
# names it as `lint_config`: rustc applies its rustc lints, and the clippy
# aspect (`--config=clippy`, see .bazelrc) its clippy deny set.
extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# CA trust for an `https://` plate-solver `url` (issue #609) and Basic
# Auth credentials (issue #620) route through the serving crates
# directly, so they need the explicit intra-workspace deps list every
# Bazel target here shares.
_INTRA_WORKSPACE_DEPS = [
    "//crates/rp-auth:rp-auth",
    "//crates/rusty-photon-tls:rusty-photon-tls",
]

# Production-clean library: no `mock` feature, no mockall in the
# linked binary. Use this from rust_library / rust_binary targets.
# Cargo gets the same shape via `[dev-dependencies] rp-plate-solver
# = { features = ["mock"] }`; Bazel needs an explicit second target
# because crate_features is a compile-time attribute of the library
# output (see docs/plans/archive/bazel-migration.md "Mockall mock variants").
rust_library(
    name = "rp-plate-solver",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "rp_plate_solver",
    edition = "2021",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

# Test-only variant exposing `MockPlateSolveClient` to downstream
# rust_test targets. `testonly = True` blocks production
# rust_library / rust_binary targets from depending on it at
# Bazel-build time, so the convention isn't only enforced by code
# review.
rust_library(
    name = "rp-plate-solver_with_mock",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["mock"],
    crate_name = "rp_plate_solver",
    edition = "2021",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "rp-plate-solver_unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":rp-plate-solver_with_mock",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = _INTRA_WORKSPACE_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
