load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The crate's `[lints]` table (inherited from `[workspace.lints]`), read from
# Cargo.toml. Every Rust target below names it as `lint_config`, so Bazel's
# rustc applies the same rustc lints as Cargo's.
extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# rp-vocabulary is a first-party leaf (not an `@cr` entry), so it is named
# as an explicit Bazel label rather than resolved by `all_crate_deps`.
# `ResolvedTarget.coord` is the validated `rp_vocabulary::IcrsCoord`
# (ADR-019), so one coordinate type spans catalog → store → planner.
_INTRA_WORKSPACE_DEPS = [
    "//crates/rp-vocabulary:rp-vocabulary",
]

rust_library(
    name = "rp-catalog",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    # The packed catalog blob is pulled in via `include_bytes!` at
    # compile time; Bazel's sandbox only stages files declared as inputs.
    compile_data = ["src/data/catalog.bin"],
    crate_name = "rp_catalog",
    edition = "2021",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "rp-catalog_unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # The sync tests `include_str!` the committed CSV sources to prove
    # the packed blob has not drifted from them.
    compile_data = ["src/data/catalog.bin"] + glob(["src/data/*.csv"]),
    crate = ":rp-catalog",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = _INTRA_WORKSPACE_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
