load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Hand-written QHYCCD SDK FFI bindings (no bindgen — `lib.rs` is a hand-written
# `extern "C"` block).
#
# `build.rs` emits the per-OS native link directives (static=qhyccd everywhere;
# dylib=usb-1.0 + dylib=stdc++ on Linux, dylib=c++ + dylib=usb-1.0 on macOS) and
# the search paths it finds the SDK on: `QHYCCD_SDK_DIR` when set, the SDK the CI
# workspace extracted (macOS, Windows), /usr/local/lib (Linux, macOS), and the
# Homebrew lib directory for libusb on macOS. The SDK itself is PROVISIONED into
# the Bazel build actions (see services/qhy-camera/BUILD.bazel + .bazelrc, which
# forward GITHUB_WORKSPACE on macOS/Windows); on Linux build.rs finds it at
# /usr/local/lib. `links = "qhyccd"` lets Bazel coordinate the native link the
# same way the Cargo `links` key does.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    edition = "2021",
    links = "qhyccd",
    visibility = ["//visibility:private"],
)

rust_library(
    name = "libqhyccd-sys",
    srcs = ["lib.rs"],
    crate_name = "libqhyccd_sys",
    crate_root = "lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [":build_script"],
)

# The build script's QHY SDK search path, which the packaging guard
# (tools/rusty-photon-ci/src/pkg_assets.rs) checks against the packaging pins.
exports_files(
    ["build.rs"],
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)

# The files the tools crate's bare-reference guard reads
# (tools/rusty-photon-ci/src/bare_refs.rs).
filegroup(
    name = "sources",
    srcs = glob(
        [
            "**/*.rs",
            "**/*.feature",
            "**/*.toml",
            "**/*.bzl",
            "**/*.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)
