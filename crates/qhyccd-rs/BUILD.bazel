load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Vendored first-party QHYCCD SDK binding (ADR-009). Two library variants — the
# same real/sim split `crates/rp-plate-solver` uses for its mock:
#   * `qhyccd-rs`      links the REAL static SDK (production).
#   * `qhyccd-rs_sim`  (testonly) enables the `simulation` feature so
#     `Sdk::new()` fabricates a pure-Rust QHY178M (no FFI, no USB) for the
#     qhy-camera BDD + ConformU suites.
# `testonly = True` makes Bazel reject any production rust_binary that links the
# simulated SDK, so the real/sim boundary is build-enforced, not review-enforced.
#
# crate_universe resolves ONE feature set per crate, so the real variant
# harmlessly carries the simulation-only optional deps (rand/rayon) as unused —
# exactly as rp-plate-solver's production variant carries mockall. The
# `libqhyccd-sys` FFI sub-crate is a workspace member depended on explicitly
# (it is NOT an `all_crate_deps` entry). See docs/services/qhy-camera.md
# "Native dependency & build gating".

_LIBQHYCCD_SYS = "//crates/qhyccd-rs/libqhyccd-sys:libqhyccd-sys"

rust_library(
    name = "qhyccd-rs",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "qhyccd_rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = [_LIBQHYCCD_SYS] + all_crate_deps(normal = True),
)

rust_library(
    name = "qhyccd-rs_sim",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["simulation"],
    crate_name = "qhyccd_rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = [_LIBQHYCCD_SYS] + all_crate_deps(normal = True),
)

# The crate's own IN-SOURCE unit tests — the `#[cfg(test)]` modules in error.rs,
# camera.rs (the `ControlType` round-trip), types.rs, and simulation.rs — run
# under Bazel against the sim variant, mirroring crates/zwo-rs:zwo-rs_unit_test.
# The `tests/simulation/*` integration suite is a SEPARATE crate, gated by the
# `qhyccd-rs_integration_test` target below (unlike zwo-rs / svbony-rs, which have
# no `tests/` dir — all their tests are in-source). Since Phase 4 of the qhyccd-rs
# convention alignment there is NO FFI-mock layer (the `#[automock]` `src/mocks.rs`
# and the `src/tests/` mock suite are gone): the real FFI arms are compiled out
# under `simulation` and the simulated backend is exercised directly, like the
# siblings. The `simulation` `crate_features` must be set explicitly — rust_test
# does NOT inherit it from the wrapped `crate` — or the `#[cfg(feature =
# "simulation")]` tests (the bulk) compile out. The sim variant still links the SDK
# (simulation removes the camera, not the link), so this runs in the
# SDK-provisioned bazel.yml / bazel-coverage.yml jobs, like zwo-rs.
rust_test(
    name = "qhyccd-rs_unit_test",
    size = "medium",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":qhyccd-rs_sim",
    crate_features = ["simulation"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The `tests/simulation/*` integration suite: the simulated-camera workflow tests
# (camera_tests.rs), image-generator tests, and config-builder tests. As a Cargo
# integration test it is a SEPARATE crate that consumes the public `qhyccd_rs` API,
# so it depends on the `qhyccd-rs_sim` rlib rather than wrapping it with `crate =`
# (that attribute is only for the in-source unit tests above). Entry point
# `tests/simulation_tests.rs` (`#![cfg(feature = "simulation")]`) pulls in the
# `simulation/` + `common/` submodules; `crate_features` and the sim variant are
# set for the same reasons as the unit test. This suite previously ran only under
# `cargo test` (the nightly Cargo safety net); wiring it here puts it in the per-PR
# Bazel gate + `bazel coverage`.
rust_test(
    name = "qhyccd-rs_integration_test",
    size = "medium",
    srcs = ["tests/simulation_tests.rs"] + glob([
        "tests/simulation/*.rs",
        "tests/common/*.rs",
    ]),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate_features = ["simulation"],
    crate_root = "tests/simulation_tests.rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [":qhyccd-rs_sim"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Doctests, ONE TARGET PER VARIANT. rules_rust runs no doctests unless a
# rust_doc_test target declares them, so without these the crate's ~55 examples
# were only ever compiled by the nightly Cargo safety net.
#
# Both variants are covered because the public API forks on the `simulation`
# feature (`Camera::new` only without it, `Camera::new_simulated` only with it)
# while most examples hang off items that are NOT themselves feature-gated —
# rustdoc collects those in both builds, so an example is only proven correct
# where it is actually compiled. Covering one variant would let an example that
# names the other's API stay green here and break the nightly instead.
#
# `crate_features` must be repeated on the sim target for the same reason as on
# the rust_test above, and it bites harder here: rust_doc_test builds its own
# CrateInfo from this attribute and does NOT inherit the wrapped crate's
# features, so a bare `crate = ":qhyccd-rs_sim"` has rustdoc COLLECT the
# non-simulation example set and then compile it against the simulated rlib —
# every feature-gated example fails on an API that isn't there.
#
# Both variants link the SDK (simulation removes the camera, not the link), so
# these run wherever the unit test does — the SDK-provisioned bazel.yml /
# bazel-coverage.yml jobs.
#
# Windows needed a MAX_PATH fix before these could run there: rust_doc_test
# spells sysroot inputs relative to the runfiles tree, whose prefix alone costs
# ~123 chars, so the crate's one RUNNABLE example (the simulated-SDK walkthrough
# in lib.rs) — the first doctest under Bazel to invoke link.exe — died on
# `LNK1181: cannot open input file …libpanic_unwind-….rlib` at 261 characters,
# one over the limit, while libstd-….rlib at 252 in the same directory resolved.
# //third_party/patches:rustdoc_test_windows_external_repo_path now resolves
# `--sysroot=` through the runfiles manifest to its execroot target, which puts
# every std rlib back under the limit. `no_run` examples never link, which is why
# the all-`no_run` service-lifecycle doc test was always green there.
rust_doc_test(
    name = "qhyccd-rs_doc_test",
    crate = ":qhyccd-rs",
)

# The sim target additionally carries `crate_features`, which rustdoc receives as
# the two argv elements `--cfg` and `feature="simulation"`. Those embedded quotes
# cannot ride a batch line — cmd.exe tracks quote state without understanding any
# escape — so the same patch puts the Windows runner's command in a companion
# .ps1 invoked via `powershell -File`, where a single-quoted argument carries `"`
# literally, and re-encodes the quotes as `\"` for PowerShell's native-command
# marshalling (which would otherwise paste them into the child's command line
# unescaped for the CRT parser to strip). That is what lets this target run on
# Windows at all.
rust_doc_test(
    name = "qhyccd-rs_sim_doc_test",
    crate = ":qhyccd-rs_sim",
    crate_features = ["simulation"],
)
