load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The crate's `[lints]` table (inherited from `[workspace.lints]`), read from
# Cargo.toml so Cargo and Bazel enforce one lint set. Every Rust target below
# names it as `lint_config`: rustc applies its rustc lints, and the clippy
# aspect (`--config=clippy`, see .bazelrc) its clippy deny set.
extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "rusty-photon-doctor-checks",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "rusty_photon_doctor_checks",
    edition = "2021",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = ["//crates/rusty-photon-process"] + all_crate_deps(normal = True),
)

# The staged USB inventory exists only under the `mock` feature, and features
# are a compile-time concept — so covering it under Bazel takes a lib twin
# built with the feature on, and its own test. Same shape as doctor's
# `doctor_lib_mock`, which exists for `--platform-facts` for the same reason.
rust_library(
    name = "rusty-photon-doctor-checks_mock",
    # `testonly` is the production-build boundary, enforced rather than
    # documented: Bazel refuses to let a non-testonly target depend on this,
    # so the staged inventory cannot reach a shipped binary even by an
    # accidental dep edit. It propagates to consumers, which is right — the
    # driver sim libraries that will stage inventories are testonly already.
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["mock"],
    crate_name = "rusty_photon_doctor_checks",
    edition = "2021",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = ["//crates/rusty-photon-process"] + all_crate_deps(normal = True),
)

rust_test(
    name = "rusty-photon-doctor-checks_mock_unit_test",
    size = "small",
    # Same reason as the default-feature suite below: the gather() tests'
    # Windows leg shells out to PowerShell.
    timeout = "moderate",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":rusty-photon-doctor-checks_mock",
    crate_features = ["mock"],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = ["//crates/rusty-photon-process"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "rusty-photon-doctor-checks_unit_test",
    size = "small",
    # The gather() tests' Windows leg shells out to PowerShell for the USB
    # inventory, once per gather; a cold CI runner can push the suite past
    # small's default 60s.
    timeout = "moderate",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":rusty-photon-doctor-checks",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = ["//crates/rusty-photon-process"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
