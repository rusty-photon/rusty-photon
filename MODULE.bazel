    # Stable (the default channel, selected in .bazelrc) is current stable —
    # the release check.yml's `stable / clippy` installs — and it is the
    # workspace MSRV's release: the root Cargo.toml's `rust-version` and
    # clippy.toml's `msrv` name it. A point release of the pin (1.99.1) needs
    # no MSRV bump, since point releases add no language or library
    # features. tools/ci/bazel-clippy.sh fails when they disagree.
    # - Current stable, because the clippy aspect (`--config=clippy`) runs
    #   this toolchain's clippy-driver, and the workspace's lint attributes
    #   track current stable clippy (an `#[expect]` only a newer clippy
    #   fulfils is an error on an older one; see docs/skills/pre-push.md).
    # - The MSRV's, because then every PR compiles what its Linux and Windows
    #   Bazel targets build with the MSRV, so code newer than it (a std API
    #   or a language feature) fails the build. A Bazel target builds one
    #   feature set, so code reached only through other Cargo feature
    #   combinations is compiled on a PR by Cargo's floating stable alone.
    # In the first PR after each stable release, bump all of them together:
    # the pin with its `sha256s`, rust-version, clippy.toml's msrv and the
    # coverage nightly below (docs/skills/pre-push.md lists the steps). Until
    # then the two clippies differ, and a change written against the new
    # stable fails `bazel clippy` here. After it merges, rebuild the pool
    # runner templates (docs/skills/proxmox-runner-pool.md), which pre-fetch
    # both toolchains: until then every pool PR job downloads the new ones
    # over the WAN.
    #
    # The pinned nightly is used ONLY by the
    # coverage workflow (.github/workflows/bazel-coverage.yml, via
    # `--config=coverage` which selects channel=nightly): the
    # #[cfg_attr(coverage_nightly, coverage(off))] attributes on every
    # `#[cfg(test)] mod tests` block require the nightly-only
    # `coverage_attribute` feature -- exactly like the Cargo coverage job
    # (.github/workflows/test.yml) which runs on nightly + cargo-llvm-cov.
    # The date is PINNED for remote-cache stability: a rolling nightly would
    # change every coverage action's cache key on each bump and bust the
    # coverage cache. Bump it if this nightly lacks the llvm-tools / rust-std /
    # rustc components for the host triple (`bazel coverage` needs llvm-cov +
    # llvm-profdata from the toolchain). It must also accept everything the
    # MSRV does: coverage compiles the same sources, so a feature the MSRV
    # allows but this nightly still marks unstable fails `bazel coverage` with
    # E0658 while the stable build passes.
    #
    # When raising rust-version, move it to the LAST nightly of the MSRV's own
    # cycle: the last date whose rustc reports the MSRV's release.
    # - It has the MSRV's stabilizations, except any that merged in the day
    #   between its build and the release's beta branch, or were backported
    #   to beta. Code using one of those passes the stable build and fails
    #   `bazel coverage` with E0658. The remedy is then the next cycle's
    #   first nightly.
    # - An earlier nightly can predate more of those stabilizations. A later
    #   one is the next release, with its new lints and deprecations.
    # - If the hash script refuses the last date because a component is
    #   missing on a host, take the latest earlier date it accepts.
    #
    # `scripts/rust-toolchain-sha256s.sh nightly/<date>` prints the hashes
    # and, on stderr, the comment line with the date's rustc version, which
    # goes directly above the entry as printed. tools/ci/bazel-clippy.sh
    # checks it: it must name the entry's date, and the MSRV's release or the
    # next one (the remedy above). So a bump that leaves the nightly behind
    # fails there.
    versions = [
        "1.99.0",
        # nightly/2026-08-15 is rustc 1.99.0-nightly (d453bdd8f 2026-08-14)
        "nightly/2026-08-15",
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# --- crate_universe: resolve crates.io + git deps from Cargo files ---------

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "cr",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)

# aws-lc-sys vendors a large C library (aws-lc/) and compiles it via the
# `cc` crate.  Its C source uses deep relative #include paths (e.g.
# ../../../../third_party/jitterentropy/...) that resolve across multiple
# subdirectories.  The default build_script_data_glob does not materialise
# every vendored file in the runfiles tree, so those includes fail with
# "No such file or directory".  Glob everything.
#
# AWS_LC_SYS_USE_SYSTEM=0 forces the vendored source build.  Left unset, the
# build script probes OPENSSL_DIR / OPENSSL_INCLUDE_DIR / OPENSSL_LIB_DIR and
# then pkg-config for a system AWS-LC, and links it dynamically if it finds
# one.  None of that host state is part of the action key, so a host that has
# AWS-LC installed would publish a dynamically-linked artifact into the shared
# disk / remote caches for hosts that do not.  Pinning the source build keeps
# the action hermetic.
crate.annotation(
    build_script_data_glob = ["**"],
    build_script_env = {"AWS_LC_SYS_USE_SYSTEM": "0"},
    crate = "aws-lc-sys",
)
use_repo(crate, "cr")
