"""rusty-photon Bazel module.

Cargo.toml remains the canonical source of dependency versions.
crate_universe reads Cargo.toml + Cargo.lock to materialize an @cr repo
that Bazel targets reference via @cr//:<name>.  The short repo name ("cr"
instead of "crates") is intentional: rules_rust embeds the repo name twice
in every build-script runfiles path, and aws-lc-sys's deeply nested vendored
source tree hits the Windows MAX_PATH (260) limit with longer names.

After any change to Cargo.lock or any workspace Cargo.toml (the root's or a
member's), run
`scripts/repin-bazel-lock.sh` to refresh MODULE.bazel.lock (rule 10;
docs/skills/pre-push.md, "Refreshing MODULE.bazel.lock").
"""

module(
    name = "rusty_photon",
    version = "0.1.0",
)

# --- Core Bazel rules ------------------------------------------------------

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")

# `sh_test`, for the runner-pool harnesses under //tools/ci. Bazel 8 moved the
# shell rules out of the builtins into this module, so they have to be loaded
# explicitly now — a bare `sh_test()` in a BUILD file fails with "name
# 'sh_test' is not defined".
bazel_dep(name = "rules_shell", version = "0.6.1")

# BUILD/.bzl formatter + linter, vendored so every dev machine (and CI) runs the
# same pinned version with no system install: `bazel run //:buildifier` formats,
# `bazel test //:buildifier_check` verifies. `dev_dependency` because rusty_photon
# is always the root module — this never needs to resolve for a downstream consumer.
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)

# Five pinned patches to rules_rust (patches 3 and 5 each span two FILES —
# Bazel's patch applier failed a two-file unified diff with
# CONTENT_DOES_NOT_MATCH_TARGET on whichever file section came second, while
# each single-file diff applies cleanly, so each file gets its own .patch).
# Bazel's applier also does no fuzz matching: on a rules_rust bump, regenerate
# every patch against the new release rather than trusting `patch` to land it.
# See docs/plans/archive/bazel-migration.md.
#
# 1. collect_coverage_extra_objects.patch — BDD rust_tests spawn the service
#    binary as a child process; the collector merges the child's profraw but
#    `llvm-cov export` only emits coverage for functions in an -object on its
#    command line, and stock rules_rust passes ONLY the test binary. The patch
#    appends each spawned binary (RUST_COVERAGE_EXTRA_OBJECTS, set on the BDD
#    targets) as an extra -object so spawned-binary src/ coverage is EXPORTED.
#    Inert when the var is unset.
#
# 2. instrumented_files_include_data.patch — adds `data` to the rust rules'
#    coverage `dependency_attributes`. llvm-cov (via patch 1) emits main.rs, but
#    bazel's lcov_merger then INTERSECTS that report with the test's
#    instrumented-files manifest, which is built only from `deps`/`crate`/`srcs`
#    — so a spawned binary reached via `data` (its src/main.rs) is filtered back
#    out. Including `data` puts the instrumented service binary's sources in the
#    manifest so main.rs survives the merge. Without this, patch 1's exported
#    main.rs coverage is silently dropped.
#
# Patches 1-2 serve spawned-service-binary coverage (the two halves of getting
# a BDD/integration child binary's src/ into the report).
#
# 3. rustdoc_test_windows_external_repo_path.patch — `rust_doc_test`'s
#    generated Windows runner receives its cross-repo tools (notably
#    `process_wrapper.exe`) as bare `..`-relative `File.short_path`s that must
#    resolve through the test's runfiles tree — and on remote-cache-hit builds
#    the tree entry for an exec-configuration tool can be absent or dangling
#    on Windows (a bazelbuild/bazel#18580-class build-without-the-bytes /
#    runfiles interplay; the runner's own `external -> ..\` symlink cannot
#    help when the tree entry itself is missing, which is why rewriting argv
#    through that symlink alone still failed on every cache-hit run). The
#    patch instead routes every argv element through a PowerShell resolver in
#    the generated runner: `..`-prefixed paths are looked up in the runfiles
#    MANIFEST and invoked via their absolute execroot targets, sidestepping
#    the tree; the `external/` rewrite remains as the no-manifest fallback,
#    and every miss prints a Write-Warning naming the exact gap.
#    Windows-only (write_test_runner_unix is untouched); this repo requires
#    unsandboxed test execution everywhere (`test:ci --spawn_strategy=local`,
#    see .bazelrc) for OmniSim's BDD network binding, so working around the
#    Windows runner is more surgical than trying to sandbox just this one
#    target — Bazel's test dispatch only consults `--strategy=TestRunner=...`,
#    which isn't scopable by target/mnemonic pattern the way `--strategy_regexp`
#    is for build actions (verified empirically: `--strategy_regexp` never
#    changed the TestRunner spawn's runner from `local`, only the unscoped
#    `--strategy=TestRunner=sandboxed` did — and that would also break BDD's
#    port binding). No upstream issue filed for this one yet.
#
#    The same resolver also rewrites `--sysroot=<dir>` (RFR, falling back to
#    the directory index RFI derives from the manifest), which fixes a MAX_PATH
#    failure (issue #739) that only a RUNNABLE doctest can hit: `no_run` examples
#    are emitted as metadata and never linked, so until qhyccd-rs got doctest
#    targets nothing under Bazel had invoked `link.exe`. rustc expands `--sysroot`
#    into the std rlib paths it hands the linker, and spelled relative to the
#    runfiles tree — whose prefix alone costs ~123 chars — they cross 260:
#    measured on CI, `libpanic_unwind-<hash>.rlib` landed at 261 and failed
#    `LNK1181: cannot open input file` while `libstd-<hash>.rlib` at 252 in the
#    SAME directory resolved. The file was present, non-symlink and readable, so
#    this is length, not availability, and bazel.yml's `LongPathsEnabled` step
#    cannot reach it — that opt-in is per binary via a `longPathAware` manifest
#    and `link.exe` carries none. Resolving the directory through the manifest
#    (RFD: the manifest maps files, so match any entry beneath the directory and
#    trim the shared suffix off its target) yields the ~155-char execroot path,
#    putting every std rlib comfortably under the limit.
#
#    The patch also restructures the runner itself: the generated .bat is now a
#    trampoline that invokes a companion .ps1 (declared by rustdoc_test.bzl as
#    an extra output of the writer action — that rule change is the
#    rustdoc_test_windows_companion_script.patch half) via `powershell -File`,
#    instead of
#    carrying the whole command as ONE `powershell.exe -c "…"` batch line. Two
#    cmd.exe limits forced this (issue #749): cmd tracks quote state without
#    honouring any escape — `\"` still toggles it — so an argv element with a
#    literal `"` (`crate_features` reaches rustdoc as `feature="simulation"`)
#    ends the -c string early, with position-dependent symptoms (an `invalid
#    --cfg argument` error, or a silent exit-1 with an empty log once the
#    preamble shifted where the quote landed); and a batch line caps at 8191
#    chars. In a .ps1, PowerShell parses the file itself: single-quoted
#    arguments carry `"` literally and no line limit applies. One quoting
#    layer remains even then — PowerShell 5.1 marshals args to a native child
#    by pasting the string into its command line with embedded `"` unescaped,
#    so the child's CRT parser strips them (CI-proven: process_wrapper
#    received `feature=simulation`) — which the runner's CRT() function
#    handles by encoding `"` as `\"` per MSVCRT rules just before that hop.
#    This is what lets qhyccd-rs's sim doctest target (the only one with
#    crate_features) run on Windows.
#
#    Finally, RF() resolves `external/`-spelled argv elements — the `--arg-file`
#    values naming build-script `_bs.linksearchpaths` outputs — through the
#    manifest as well (issue #752, the #587 family-2 flake): windows-latest
#    intermittently leaves that runfiles-tree entry as a DANGLING symlink
#    (file=false symlink=true len=0, parent dir real) which no amount of
#    retrying in process_wrapper (patch 4) can outlast, while the manifest's
#    execroot target is a real file — `build:windows
#    --remote_download_outputs=all` wins over build:ci's `toplevel` because
#    --enable_platform_specific_config appends platform lines last (see
#    .bazelrc), so every output is materialized even on remote-cache hits.
#
#    The flake has a MAIN-REPO leg too (issue #781): when the build script
#    belongs to a first-party path dependency (libqhyccd-sys), its
#    `build_script.linksearchpaths` `--arg-file` value is spelled bare
#    workspace-relative (`crates/...`), which the resolver used to pass
#    through untouched — and the real/sim qhyccd-rs doc-test pair, which
#    shares that runfile, raced on the dangling tree entry whenever both
#    executed on the same runner (exactly one lost per attempt, alternating
#    victims). RF() therefore also looks bare relative-path argv elements up
#    under the workspace runfiles directory (`TEST_WORKSPACE`, `_main` under
#    Bzlmod), which routes the crate root and first-party `--arg-file` values
#    through the manifest's execroot targets as well; a lookup miss falls
#    through silently, since a bare element may not be a path at all.
#
#    Those three spellings all describe BARE argv elements, and the rlibs
#    rustdoc opens are not among them (issue #796): a direct dependency arrives
#    as `--extern=<name>=<rlib>`, and the documented crate's own rlib as the
#    `<name>=<path>` value of a bare `--extern`. Both stayed tree-relative, so
#    every doctest's direct dependencies still rode the surface the paragraphs
#    above exist to get off. RF therefore splits the flag off and resolves the
#    value the same way. Reading the failure from logs alone is hard, because
#    rustdoc reports a lost rlib two different ways depending on which of its
#    two stats of the path lost: `extern location for X does not exist` when
#    the first did, and a bare `E0463: can't find crate for X` when the first
#    succeeded and the second did not — rustc's metadata loader treats a file
#    that vanished in between as simply absent (locator.rs
#    `MetadataError::NotPresent`) and falls back to the search directories
#    without recording a rejection, so no note ever names the file. Both
#    messages appeared, for the same crate, across two occurrences 15 minutes
#    apart. Resolving through the manifest also buys MAX_PATH headroom on the
#    same budget `--sysroot=` needed: the longest dependency rlib measured
#    reached exactly 260 characters through the tree against 150 through the
#    manifest.
#
#    `-L[<kind>]=<dir>` search paths are deliberately NOT rewritten. A
#    directory has no manifest entry of its own — RFD infers one by matching
#    any file beneath it — and that inference is ambiguous exactly when a repo
#    contributes both source files and generated outputs to the runfiles,
#    because both walk up to the same repo directory while their targets live
#    in different trees: `<output_base>/external/<repo>` holds the sources,
#    `<output_base>/execroot/.../bazel-out/<cfg>/bin/external/<repo>` the
#    rlibs. Rewriting them picked the source directory for whichever repos
#    enumerated that way, which holds no rlib at all — CI-proven, via the
#    runner's own argv trace (RUSTDOC_TEST_TRACE_ARGV; see .bazelrc):
#    `-Ldependency=C:/b/external/rules_rust++crate+cr__owo-colors-4.3.0`.
#    `--extern=` values carry no such ambiguity: they name a FILE, which has
#    exactly one manifest entry. `--sysroot=` keeps using RFD because the
#    toolchain repo contributes only one of the two trees.
#
#    Those search paths are nonetheless reachable, because most of them are not
#    argv elements at all: a build script's link search paths arrive inside an
#    `--arg-file`, spelled `-Lnative=${pwd}/bazel-out/...`, and process_wrapper
#    expands `${pwd}` to its own current directory — on the assumption rustc.bzl
#    states outright, that "`${pwd}` ... resolves the `exec_root` at action
#    execution time". True of a build action, false of a doc TEST, which Bazel
#    runs from the runfiles tree. Both halves of the expansion then go wrong:
#    the runfiles `<workspace>` directory holds only the workspace's own
#    sources, so `${pwd}/bazel-out/...` names a directory that is not there at
#    all, and the ~153-char runfiles prefix pushes the result past the MAX_PATH
#    ceiling described above. Measured on CI, that put
#    `windows_x86_64_msvc`'s `windows.0.52.0.lib` at 338 characters against a
#    dependency rlib at 243 in the same argv that resolved — the toolchain's own
#    copy of that lib, reached through the unrewritten `-L`, sits at 272 and is
#    equally out of reach, so link.exe found neither and failed `LNK1181: cannot
#    open input file`. The runner therefore rewrites the one argv element that
#    controls the expansion, `pwd=${pwd}`, to a literal exec root (XR, cut from
#    the CWD at its first `bazel-out` segment): the directory then exists and
#    the same lib spells out at 204. process_wrapper's own `${exec_root}` is not
#    usable for this — it derives from an output_base found by canonicalizing
#    `<cwd>/external`, which under the runfiles tree is the runner's own
#    `external -> ..\` symlink and resolves to the runfiles root, not the output
#    base.
#
#    process_wrapper's `--subst <path>=<path>` pairs, one per build-script output
#    directory, pass through RF() untouched: each is a substitution rule, not a
#    path, and the `external/` branch would otherwise warn about a runfile that
#    was never a file. Resolving them would change nothing: the writer strips
#    the `bazel-out/<cfg>/bin/` root off each key too, so no key matches the
#    `${<out_dir>}` tokens the `--arg-file` contents carry, and a search path
#    under a build script's OUT_DIR stays unresolved inside a doc test. That
#    does not reach the doc tests here: a static native library rides inside
#    its crate's rlib, and an import library such as `windows.0.52.0.lib` sits
#    under its crate's CARGO_MANIFEST_DIR — a `.cargo_runfiles` directory beside
#    the OUT_DIR, not inside it — spelled `${pwd}/bazel-out/...`, which the
#    `pwd=${pwd}` rewrite above already resolves.
#
# 4. process_wrapper_read_retry.patch — process_wrapper reads its `--arg-file`
#    inputs with a single unretried `File::open`, and on windows-latest that
#    open rarely fails with a transient ERROR_ACCESS_DENIED on a runfile that
#    exists and reads fine moments later (issue #587 family 2: the
#    service-lifecycle `rust_doc_test` died on a varying
#    `_bs.linksearchpaths` file, 4 hits in one evening). Defender is ruled
#    out — GitHub's runner images disable real-time protection and exclude
#    `C:\` at the image level — so the residual suspect is a transient
#    delete-pending/planting window in the same bazelbuild/bazel#18580-class
#    family as patch 3. The patch retries the open (3 attempts, short
#    backoff) on Windows os errors 5/32, prints a warning per retry so
#    occurrences stay countable in test logs, and appends the path's
#    filesystem state to a final failure so a persistent denial is
#    diagnosable from the error alone. Inert on the happy path and on
#    non-Windows. No upstream issue filed yet.
#
#    The diagnostic later proved the recurrence (issue #752) is a DANGLING
#    runfiles-tree symlink, which retrying cannot outlast — patch 3's RF()
#    now routes those `--arg-file` paths through the runfiles manifest to
#    their execroot targets, so this retry remains only as the backstop for
#    paths the manifest cannot resolve.
#
# 5. rustdoc_test_inline_args_rustc.patch + rustdoc_test_inline_args_rustdoc.patch
#    — rules_rust spills `rustc_flags` to a params file on every action, not
#    only when the command line is too long. For a doc test that file is the
#    `.rustdoc_opt_params` the writer copies through with only the exec-root
#    prefixes stripped, so every flag in it — `--extern=`, `--sysroot=`, the
#    crate root, the `--arg-file` values — skips patch 3's runner resolver and
#    reaches rustdoc tree-relative again, which is exactly the surface patch 3
#    exists to get Windows off. The rustc.bzl half adds an
#    `always_use_param_file` option to `construct_arguments` (default True,
#    upstream's behaviour); the rustdoc.bzl half turns it off for doc tests
#    only, so their flags stay on the command line unless they cannot fit.
#    Every other action keeps the always-spill. bazel.yml's "Report doc-test
#    argument routing (Windows)" step shows it holding: each doc test should
#    report `params file: unused`.
#
# Upstream has no equivalent hooks for 1-2 (collect_coverage PRs #3490/#3808
# unmerged; still absent in 0.74.0), so these are carried until upstreamed.
# The `bazel/cargo target parity` CI job guards that the patches still apply
# and are effective.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//third_party/patches:collect_coverage_extra_objects.patch",
        "//third_party/patches:instrumented_files_include_data.patch",
        "//third_party/patches:rustdoc_test_windows_external_repo_path.patch",
        "//third_party/patches:rustdoc_test_windows_companion_script.patch",
        "//third_party/patches:process_wrapper_read_retry.patch",
        "//third_party/patches:rustdoc_test_inline_args_rustc.patch",
        "//third_party/patches:rustdoc_test_inline_args_rustdoc.patch",
    ],
)

