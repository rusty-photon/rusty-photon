/target
target
lcov.info
*.profraw
.vscode
.env

# ZWO MIT SDK blobs staged there by scripts/build-packages.sh right before
# `cargo deb` runs; downloaded from the pinned indi-3rdparty ref, never
# committed (ADR-013).
services/zwo-camera/pkg/lib/
services/zwo-focuser/pkg/lib/

# Package build output of scripts/build-packages.sh (deb/rpm + SHA256SUMS).
/dist/

# Bazel
# bazel-* are workspace symlinks at the repo root (bazel-bin, bazel-out, ...).
# Anchored to root so it doesn't match e.g. docs/plans/archive/bazel-migration.md.
/bazel-*
# wrangler's local state (created by `wrangler deploy` in the tools/*-worker/ dirs).
.wrangler/
# user.bazelrc allows per-developer overrides without touching .bazelrc.
user.bazelrc
# MODULE.bazel.lock IS committed (like Cargo.lock) for reproducibility.

# Claude Code runtime artifacts.
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/worktrees/
/site/

# SVBony camera SDK parameter dumps: libSVBCameraSDK writes per-model
# auto-save config files into the process working directory whenever a
# camera is opened (e.g. U3SM900C-AST_Cfg_A.bin for the SV605CC).
*_Cfg_A.bin
*_Cfg_SAVE.bin
crates/rp-catalog/scripts/build/

# Python bytecode from the tools/ scripts
__pycache__/
*.pyc

# OmniSim's own ASCOM logs: the simulator writes an `ascom/logs<date>/`
# tree into its working directory, which for a local `cargo test -p rp
# --test bdd` run is services/rp/. Test artifact, never committed.
**/ascom/logs*/
