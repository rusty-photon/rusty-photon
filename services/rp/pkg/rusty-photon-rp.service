[Unit]
Description=Rusty Photon rp - equipment gateway, event bus, and safety enforcer (port 11115)
# rp dials its tool providers at startup and fails when one is down
# (rp.md § Tool Provider Registration); calibrator-flats is the shipped
# one, so a cold boot brings it up first. Ordering only, not a
# requirement: an rp config that registers no provider starts either way.
After=network.target rusty-photon-calibrator-flats.service

[Service]
Type=simple
ExecStart=/usr/bin/rusty-photon-rp
Restart=on-failure
RestartSec=5
User=rusty-photon
Group=rusty-photon
Environment=RUST_LOG=info
Environment=HOME=/var/lib/rusty-photon
WorkingDirectory=/var/lib/rusty-photon
StateDirectory=rusty-photon/rp

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rusty-photon
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
