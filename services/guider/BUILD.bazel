load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

_INTRA_WORKSPACE_DEPS = [
    "//crates/rp-auth:rp-auth",
    "//crates/rp-guiding:rp-guiding",
    "//crates/rusty-photon-config:rusty-photon-config",
    "//crates/rusty-photon-doctor-checks:rusty-photon-doctor-checks",
    "//crates/rusty-photon-rolling-stats:rusty-photon-rolling-stats",
    "//crates/rusty-photon-server-config:rusty-photon-server-config",
    "//crates/rusty-photon-service-lifecycle:rusty-photon-service-lifecycle",
    "//crates/rusty-photon-tls:rusty-photon-tls",
]

rust_library(
    name = "guider_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    crate_name = "guider",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

rust_binary(
    name = "guider",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = [":guider_lib"] + _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "guider_unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":guider_lib",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    # The camera loop's tests measure frames the simulator renders.
    deps = ["//crates/guide-simulator"] + _INTRA_WORKSPACE_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The guide log held to PHD2's format: the parser built from the logs PHD2
# wrote on the rigs accepts each of them, and a log the guider's writer
# writes (docs/services/guider.md § Guide log).
rust_test(
    name = "guide_log_format",
    size = "small",
    srcs = [
        "tests/bdd/phd2_log.rs",
        "tests/guide_log_format.rs",
    ],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate_root = "tests/guide_log_format.rs",
    data = glob(["tests/fixtures/guide-logs/**"]),
    edition = "2021",
    env = {
        "CARGO_MANIFEST_DIR": "services/guider",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [":guider_lib"] + _INTRA_WORKSPACE_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# BDD cucumber suite: each scenario starts the guider binary
# (GUIDER_BINARY) against `guide-simulator-alpaca`'s devices, served in
# the test process (docs/services/guider.md § Testing).
rust_test(
    name = "bdd",
    # Spawns a service process per scenario, and a wait gives the guider up
    # to 60 s (WAIT_BUDGET in tests/bdd/world.rs) to show what a scenario
    # expects; the target's timeout outlasts it.
    size = "large",
    srcs = ["tests/bdd.rs"] + glob(["tests/bdd/**/*.rs"]),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate_root = "tests/bdd.rs",
    data = [
        "Cargo.toml",
        ":guider",
    ] + glob(["tests/features/**"]),
    edition = "2021",
    env = {
        "BDD_PACKAGE_DIR": "services/guider",
        "GUIDER_BINARY": "$(rootpath :guider)",
        "RUST_COVERAGE_EXTRA_OBJECTS": "$(rootpath :guider)",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    # bdd-infra derives {PKG_UPPER_SNAKE}_BINARY from CARGO_PKG_NAME, so it must
    # be the service name (rules_rust would otherwise use the crate name "bdd").
    rustc_env = {"CARGO_PKG_NAME": "guider"},
    tags = ["bdd"],
    use_libtest_harness = False,
    deps = [
        ":guider_lib",
        "//crates/bdd-infra:bdd-infra_tls_auth",
        "//crates/guide-simulator",
        "//crates/guide-simulator-alpaca",
    ] + _INTRA_WORKSPACE_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The files the tools crate's bare-reference guard reads
# (tools/rusty-photon-ci/src/bare_refs.rs).
filegroup(
    name = "sources",
    srcs = glob(
        [
            "**/*.rs",
            "**/*.feature",
            "**/*.toml",
            "**/*.bzl",
            "**/*.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)
