load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(
    [
        "Cargo.toml",
        "pkg/doctor.toml",
        "pkg/90-rusty-photon-qhy.rules",
    ],
    visibility = ["//visibility:public"],
)

# qhy-camera links the proprietary QHYCCD SDK (libqhyccd-sys → static=qhyccd +
# libusb-1.0 + stdc++). The SDK is PROVISIONED into the Bazel actions
# (`ivonnyssen/qhyccd-sdk-install@v3` + per-OS libusb in .github/workflows/bazel.yml
# and bazel-coverage.yml; on Linux build.rs finds it at /usr/local/lib, and on
# macOS/Windows `.bazelrc` forwards `GITHUB_WORKSPACE` so build.rs finds the
# workspace-extracted SDK). The library, binary, unit test, BDD, and ConformU
# suites are ALL first-class `//...` targets — they build and run under Bazel.
#
# The prod library/binary/unit-test link the REAL SDK via the first-party
# //crates/qhyccd-rs:qhyccd-rs library; the `_sim` library/binary and the
# bdd/conformu tests link //crates/qhyccd-rs:qhyccd-rs_sim (the `testonly`
# `simulation`-feature variant) so the simulated `Sdk::new()` (a pure-Rust
# QHY178M, no FFI) is used and no USB is enumerated on a hardware-less CI
# runner. Since qhyccd-rs is now a workspace member with its own real/sim
# two-variant BUILD (ADR-009), the variant is selected by which target each
# rule depends on — not by a crate_universe feature nudge. See
# docs/services/qhy-camera.md "Native dependency & build gating".

_INTRA_WORKSPACE_DEPS = [
    "//crates/rusty-photon-camera-core:rusty-photon-camera-core",
    "//crates/rusty-photon-config:rusty-photon-config",
    "//crates/rusty-photon-doctor-checks:rusty-photon-doctor-checks",
    "//crates/rusty-photon-driver:rusty-photon-driver",
    "//crates/rusty-photon-server-config:rusty-photon-server-config",
    "//crates/rusty-photon-service-lifecycle:rusty-photon-service-lifecycle",
    "//crates/rp-auth:rp-auth",
    "//crates/rusty-photon-tls:rusty-photon-tls",
]

# The real-SDK qhyccd-rs library (prod targets) and its simulated counterpart
# (BDD / ConformU targets).
_QHYCCD_REAL = "//crates/qhyccd-rs:qhyccd-rs"

_QHYCCD_SIM = "//crates/qhyccd-rs:qhyccd-rs_sim"

# Windows delay-load of the proprietary qhyccd.dll for the REAL-SDK link
# targets — the Bazel mirror of services/qhy-camera/build.rs (hand-written
# BUILD targets do not run cargo build scripts; link args do not propagate
# from a dependency's build script in either build system). MSVC-only syntax
# (the repo's Windows toolchain). The sim targets take none: their FFI is
# cfg'd out, so no qhyccd.dll imports exist to delay (LNK4199 otherwise).
# See docs/services/qhy-camera.md § "Windows: qhyccd.dll resolution".
_WINDOWS_DELAYLOAD_FLAGS = select({
    "@platforms//os:windows": [
        "-Clink-arg=/DELAYLOAD:qhyccd.dll",
        "-Clink-arg=delayimp.lib",
    ],
    "//conditions:default": [],
})

rust_library(
    name = "qhy-camera_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    crate_name = "qhy_camera",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = [_QHYCCD_REAL] + _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

rust_binary(
    name = "qhy-camera",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = _WINDOWS_DELAYLOAD_FLAGS,
    visibility = ["//visibility:public"],
    deps = [
        ":qhy-camera_lib",
        _QHYCCD_REAL,
    ] + _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

# Unit tests run against the simulation lib (`:qhy-camera_lib_sim` →
# `//crates/qhyccd-rs:qhyccd-rs_sim`), matching zwo-camera / svbony-camera rather
# than the real variant the production lib links. Two reasons: (1) the
# `#[cfg(all(test, feature = "simulation"))]` backend tests then compile + run;
# (2) `bazel coverage` never instruments the crate's compiled-out real-FFI arms,
# so qhyccd-rs `camera.rs` is not dragged to a false ~57% by never-executed
# real-SDK lines (the real arms need physical hardware / ConformU, not the unit
# suite). See docs/services/qhy-camera.md "Native dependency & build gating".
rust_test(
    name = "qhy-camera_unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    compile_data = ["pkg/doctor.toml"],
    crate = ":qhy-camera_lib_sim",
    # Set explicitly — rust_test does NOT inherit `crate_features` from the
    # wrapped crate; `simulation` (via the `mock` alias) is what the sim code
    # paths + sim-gated tests need. No `_WINDOWS_DELAYLOAD_FLAGS`: the sim FFI is
    # cfg'd out, so there are no qhyccd.dll imports to delay (LNK4199 otherwise).
    crate_features = [
        "mock",
        "simulation",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = _INTRA_WORKSPACE_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The `simulation`-backed (mock alias) library + binary for BDD / ConformU.
rust_library(
    name = "qhy-camera_lib_sim",
    # Test-only: links the `testonly` qhyccd-rs_sim (simulated SDK). Bazel
    # therefore forbids any production target from depending on it.
    testonly = True,
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    crate_features = [
        "mock",
        "simulation",
    ],
    crate_name = "qhy_camera",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [_QHYCCD_SIM] + _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

rust_binary(
    name = "qhy-camera_sim",
    testonly = True,
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_features = [
        "mock",
        "simulation",
    ],
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        ":qhy-camera_lib_sim",
        _QHYCCD_SIM,
    ] + _INTRA_WORKSPACE_DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "conformu_integration",
    size = "large",
    srcs = ["tests/conformu_integration.rs"],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate_features = [
        "mock",
        "conformu",
        "simulation",
    ],
    data = [":qhy-camera_sim"],
    edition = "2021",
    env = {
        "QHY_CAMERA_BINARY": "$(rootpath :qhy-camera_sim)",
        "RUST_COVERAGE_EXTRA_OBJECTS": "$(rootpath :qhy-camera_sim)",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"CARGO_PKG_NAME": "qhy-camera"},
    tags = ["conformu"],
    deps = [
        ":qhy-camera_lib_sim",
        _QHYCCD_SIM,
        "//crates/bdd-infra:bdd-infra_conformu",
    ] + _INTRA_WORKSPACE_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "bdd",
    # "small" is a 60 s budget, which leaves no room for one scenario to spend
    # its IMAGE_READY_BUDGET before failing: a stuck frame would blow the shard
    # as an opaque Bazel TIMEOUT instead of naming the scenario and the wait
    # that expired. Kept in step with the sibling camera suites. "medium" is
    # 300 s.
    size = "medium",
    srcs = ["tests/bdd.rs"] + glob(["tests/bdd/**/*.rs"]),
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate_root = "tests/bdd.rs",
    data = [
        "Cargo.toml",
        ":qhy-camera_sim",
    ] + glob(["tests/features/**"]),
    edition = "2021",
    env = {
        "BDD_PACKAGE_DIR": "services/qhy-camera",
        "QHY_CAMERA_BINARY": "$(rootpath :qhy-camera_sim)",
        "RUST_COVERAGE_EXTRA_OBJECTS": "$(rootpath :qhy-camera_sim)",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    # bdd-infra derives {PKG_UPPER_SNAKE}_BINARY from CARGO_PKG_NAME; it must be
    # the service name, not the crate name ("bdd").
    rustc_env = {"CARGO_PKG_NAME": "qhy-camera"},
    tags = ["bdd"],
    use_libtest_harness = False,
    deps = [
        ":qhy-camera_lib_sim",
        _QHYCCD_SIM,
        "//crates/bdd-infra:bdd-infra_tls_auth",
    ] + _INTRA_WORKSPACE_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
