---
source: services/ui-htmx/tests/bdd/snapshot.rs
---
<div class="card" id="config-card"><h1>qhy-focuser</h1><p class="subtitle">qhy-focuser · focuser</p><form hx-post="/config/rp:focusers:qhy-focuser" hx-target="#config-card" hx-swap="outerHTML"><input type="hidden" name="__config" value="{&quot;focuser&quot;:{&quot;description&quot;:&quot;BDD test instance&quot;,&quot;enabled&quot;:true,&quot;max_step&quot;:60000,&quot;name&quot;:&quot;QHY Q-Focuser&quot;,&quot;reverse&quot;:false,&quot;speed&quot;:0,&quot;unique_id&quot;:&quot;qhy-focuser-ui-bdd&quot;},&quot;serial&quot;:{&quot;baud_rate&quot;:9600,&quot;polling_interval&quot;:&quot;100ms&quot;,&quot;port&quot;:&quot;/dev/ttyACM0&quot;,&quot;timeout&quot;:&quot;2s&quot;},&quot;server&quot;:{&quot;bind_address&quot;:&quot;0.0.0.0&quot;,&quot;port&quot;:<port>}}"><input type="hidden" name="__overrides" value="[]"><input type="hidden" name="__unlocked" value="[&quot;focuser.unique_id&quot;]"><fieldset><legend>Focuser</legend><div class="field"><label for="focuser.description">Description</label><input type="text" id="focuser.description" name="focuser.description" value="BDD test instance"></div><div class="field pinned"><div class="checkbox"><input type="checkbox" id="focuser.enabled" name="focuser.enabled" checked disabled><label for="focuser.enabled">Enabled</label></div><div class="hint">Read-only for now — editing it here would lose the connection to the driver. Change it in the driver's configuration file.</div></div><div class="field"><label for="focuser.max_step">Max step</label><input type="number" min="0" id="focuser.max_step" name="focuser.max_step" value="60000"></div><div class="field"><label for="focuser.name">Name</label><input type="text" id="focuser.name" name="focuser.name" value="QHY Q-Focuser"></div><div class="field"><div class="checkbox"><input type="checkbox" id="focuser.reverse" name="focuser.reverse"><label for="focuser.reverse">Reverse</label></div></div><div class="field"><label for="focuser.speed">Speed</label><input type="number" min="0" max="255" id="focuser.speed" name="focuser.speed" value="0"></div><div class="field"><label for="focuser.unique_id">Unique id</label><input type="text" id="focuser.unique_id" name="focuser.unique_id" value="qhy-focuser-ui-bdd"><div class="hint warning">Unlocked — editing the driver's identity is an escape hatch for a misbehaving driver. <button class="link" type="button" hx-get="/config/rp:focusers:qhy-focuser" hx-target="#config-card" hx-swap="outerHTML">Lock again</button></div></div></fieldset><fieldset><legend>Serial</legend><div class="field"><label for="serial.baud_rate">Baud rate</label><input type="number" min="0" id="serial.baud_rate" name="serial.baud_rate" value="9600"></div><div class="field"><label for="serial.polling_interval">Polling interval</label><input type="text" id="serial.polling_interval" name="serial.polling_interval" value="100ms"></div><div class="field"><label for="serial.port">Port</label><input type="text" id="serial.port" name="serial.port" value="/dev/ttyACM0"></div><div class="field"><label for="serial.timeout">Timeout</label><input type="text" id="serial.timeout" name="serial.timeout" value="2s"></div></fieldset><fieldset><legend>Server</legend><div class="field"><label for="server.bind_address">Bind address</label><input type="text" id="server.bind_address" name="server.bind_address" value="0.0.0.0"></div><div class="field"><label for="server.discovery_port">Discovery port</label><input type="number" min="0" max="65535" id="server.discovery_port" name="server.discovery_port" value=""></div><div class="field pinned"><label for="server.port">Port</label><input type="number" min="0" max="65535" id="server.port" name="server.port" value="<port>" disabled><div class="hint">Read-only for now — editing it here would lose the connection to the driver. Change it in the driver's configuration file.</div></div></fieldset><div class="actions"><button class="primary" type="submit">Apply</button></div></form></div>
