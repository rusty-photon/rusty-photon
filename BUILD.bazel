# Top-level package.
# Exports Cargo.toml and Cargo.lock so crate_universe can read them from
# MODULE.bazel.

load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

exports_files(
    [
        "Cargo.toml",
        "Cargo.lock",
    ],
    visibility = ["//visibility:public"],
)

# The workflows and actionlint's list of our runners' labels, read by the tools
# crate's guard on self-hosted runners (tools/rusty-photon-ci/src/pool_routing.rs).
# Neither `.github/workflows` nor `.github` has a BUILD file, so these files
# belong to this package. A glob that matches nothing leaves the guard finding
# no routes, which fails it.
filegroup(
    name = "workflows",
    srcs = glob(
        [
            ".github/workflows/*.yml",
            ".github/workflows/*.yaml",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)

exports_files(
    [".github/actionlint.yaml"],
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)

# MODULE.bazel's Rust toolchain pins, read by the tools crate's test that they
# agree with each other and with the MSRV
# (tools/rusty-photon-ci/src/toolchain_pins.rs).
exports_files(
    ["MODULE.bazel"],
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)

# The packaging scripts, the shared maintainer scripts and the MSI's WiX
# sources, which the tools crate's packaging guard checks agree with each other
# and with each service's pkg/ (tools/rusty-photon-ci/src/pkg_assets.rs).
# Neither `packaging`, `scripts` nor `installer` has a BUILD file.
filegroup(
    name = "packaging_files",
    srcs = [
        "installer/Package.wxs",
        "packaging/postinst.common",
        "packaging/postinst.udev-stanza",
        "packaging/postrm.common",
        "scripts/build-msi.ps1",
        "scripts/build-packages.sh",
        "scripts/build-tarballs.sh",
        "scripts/generate-brew-formulas.sh",
        "scripts/verify-brew.sh",
        "scripts/verify-packages.sh",
    ] + glob(["installer/fragments/*.wxs"]),
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)

# The title and label install-astap.yml gives its tracking issue, which the
# refresh-astap action's tests check it finds the issue by.
exports_files(
    [".github/workflows/install-astap.yml"],
    visibility = ["//.github/actions:__pkg__"],
)

# The cloud cache's URL and the file CI's remote-cache config is in, which the
# remote-cache action's tests check it agrees with.
exports_files(
    [".bazelrc"],
    visibility = ["//.github/actions:__pkg__"],
)

# The coverage job's check poster and the module it imports, which the
# uncovered-diff-lines action runs from the checkout: its tests run the poster
# and check the action names it where it is.
exports_files(
    [
        "tools/coverage/filter_lcov.py",
        "tools/coverage/post_check_annotations.py",
    ],
    visibility = ["//.github/actions:__pkg__"],
)

# `bazel run //:buildifier` formats every BUILD / *.bzl / MODULE.bazel file in the
# workspace in place. Pinned via MODULE.bazel (buildifier_prebuilt) so every dev
# machine and CI run the identical formatter with no system install.
# `exclude_patterns` keeps the formatter out of nested agent git worktrees under
# `.claude/` (see `buildifier_check` below for the full rationale).
buildifier(
    name = "buildifier",
    exclude_patterns = ["./.claude/*"],
    mode = "fix",
)

# `bazel test //:buildifier_check` fails if any BUILD / *.bzl file is unformatted.
# Runs non-sandboxed over the real tree (rooted at MODULE.bazel) so it covers every
# package, not just this one. Wire into Bazel CI as the format gate.
#
# `exclude_patterns` prunes `.claude/` from the walk. In `no_sandbox` + `workspace`
# mode this rule's generated runner does a literal `cd <repo-root> && find . -name
# '*.bazel' ... | xargs buildifier`. Agent git worktrees are nested *inside* the
# checkout at `.claude/worktrees/<name>/`, each a full repo copy with its own BUILD
# files, so the bare `find .` descends into them and lints their (often stale, e.g.
# pre-buildifier-adoption) BUILD files — failing the check and blocking every commit
# via the pre-commit hook. `.bazelignore` does NOT help: it only governs Bazel's
# loading phase (`//...`, `glob()`), not a non-sandboxed test that shells out to
# `find`, which honors neither `.bazelignore` nor git-worktree boundaries.
buildifier_test(
    name = "buildifier_check",
    exclude_patterns = ["./.claude/*"],
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    tags = ["no-sandbox"],
    verbose = True,
    workspace = "//:MODULE.bazel",
)
