<?xml version="1.0" encoding="utf-8"?>
<!--
  rusty-photon-sky-survey-camera — Windows service fragment (suite MSI; ADR-015).
  Port 11116/tcp; gated: no defaultable config.
  Note: 11116 is the packaging convention: sky-survey-camera has no code default
  port; the operator's config file must set server.port.
  The fragment contract (service name, exe rename,
  failure actions + failure-actions flag, firewall port, start and stop) is
  checked by tools/rusty-photon-ci/src/pkg_assets.rs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Fragment>
    <ComponentGroup Id="SkySurveyCameraComponents" Directory="INSTALLFOLDER">
      <Component Id="SkySurveyCameraExe">
        <File Id="SkySurveyCameraExeFile" Name="rusty-photon-sky-survey-camera.exe" Source="!(bindpath.bin)\sky-survey-camera.exe" KeyPath="yes" />
        <ServiceInstall Id="SkySurveyCameraService"
                        Name="rusty-photon-sky-survey-camera"
                        DisplayName="rusty-photon-sky-survey-camera"
                        Description="ASCOM Alpaca Camera simulator that renders frames from NASA SkyView imagery."
                        Start="auto"
                        Type="ownProcess"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="--service"
                        Vital="yes">
          <!-- systemd Restart=on-failure / RestartSec=5 translation (ADR-015
               decision 2): restart after 5 s on every failure, indefinitely
               (failure count resets daily). -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
          <!-- SERVICE_CONFIG_FAILURE_ACTIONS_FLAG: the SCM wrapper reports a
               failed run closure as SERVICE_STOPPED + ServiceSpecific(1) (see
               rusty-photon-service-lifecycle runner.rs), which only counts as
               a failure — and triggers the restart actions above — with this
               flag set. Without it the serial drivers' eager-validation exits
               would stop the service permanently. -->
          <ServiceConfig FailureActionsWhen="failedToStopOrReturnedError"
                         OnInstall="yes"
                         OnReinstall="yes" />
        </ServiceInstall>
        <!-- Started on install and at boot like every other service, which
             does itself what the Linux unit's ConditionPathExists= does
             (ADR-025).
             Without %ProgramData%\rusty-photon\sky-survey-camera.json it stops at
             once with exit code 0, which the failure actions leave alone:
             the operator writes the file, then starts the service (sc start /
             Services.msc) or reboots. The start does not wait for the service
             to run, which without its config it never does; the stop waits,
             so the exe is not replaced or removed while it runs. -->
        <ServiceControl Id="SkySurveyCameraServiceControl"
                        Name="rusty-photon-sky-survey-camera"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
        <ServiceControl Id="SkySurveyCameraServiceStart"
                        Name="rusty-photon-sky-survey-camera"
                        Start="install"
                        Wait="no" />
        <!-- Alpaca/HTTP over the LAN is the service's whole point; Windows
             Firewall blocks inbound by default. Scope=any, not localSubnet:
             multi-subnet observatory networks are the norm here (Linux ships
             no firewall config at all — parity is "reachable"). -->
        <fw:FirewallException Id="SkySurveyCameraFirewall"
                              Name="rusty-photon-sky-survey-camera"
                              Description="Inbound TCP for the rusty-photon-sky-survey-camera service (port 11116)"
                              Port="11116"
                              Protocol="tcp"
                              Scope="any" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
