#!/bin/sh
set -e

# First, because it is quick and the clippy passes are not: a Cargo file
# staged without a refreshed MODULE.bazel.lock fails every Bazel leg in CI.
# The fix it asks for is `scripts/repin-bazel-lock.sh`.
#
# Every worktree runs this one installed hook, so it also runs on branches
# that predate the check; there it skips rather than refusing every commit.
# python3 is probed by running it, because on Windows `command -v` also finds
# the Store alias that only prints an install hint. CI still enforces the lock
# whenever this skips.
if [ ! -f tools/ci/check_bazel_lock.py ]; then
  echo '! tools/ci/check_bazel_lock.py not in this checkout — skipping the lock check'
elif ! python3 -c '' >/dev/null 2>&1; then
  echo '! python3 not available — skipping the lock check (CI still enforces it)'
else
  echo '+python3 tools/ci/check_bazel_lock.py'
  python3 tools/ci/check_bazel_lock.py
fi

echo '+cargo clippy --all --all-targets --all-features -- -D warnings'
cargo clippy --all --all-targets --all-features -- -D warnings
# Second pass, default features + production targets: lints the `not(feature =
# "mock")` / `not(feature = "simulation")` slices that `--all-features` cfgs
# out (#988). `--lib --bins` rather than `--all-targets` — dev-dependency
# edges would otherwise force those features back on via unification (see the
# `clippy` job comment in check.yml, which runs the same pair).
echo '+cargo clippy --all --lib --bins -- -D warnings'
cargo clippy --all --lib --bins -- -D warnings
echo '+cargo fmt --all -- --check'
cargo fmt --all -- --check

# Buildifier (BUILD/*.bzl/MODULE.bazel formatting + lint) — the same gate CI runs
# via `bazel test //...`. Guarded on bazel being installed so the hook stays
# usable for devs who build only with Cargo. Run `bazel run //:buildifier` to
# auto-fix.
if command -v bazel >/dev/null 2>&1; then
  echo '+bazel test //:buildifier_check'
  bazel test //:buildifier_check
else
  echo '! bazel not found — skipping buildifier_check (CI still enforces it)'
fi
