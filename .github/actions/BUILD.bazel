# Tests of the CI's local JavaScript actions (ADR-022), run by `bazel test
# //...` on every OS leg, on the Node that MODULE.bazel pins.
#
# One package holds everything under .github/actions: an action's directory
# gets no BUILD file of its own, and its tests are declared here, so that
# `link_test` covers every file (node_link_test refuses a BUILD file below
# this one). Conventions: docs/skills/ci-logic.md.

load(":node_test.bzl", "node_binary", "node_link_test", "node_test")

# The helper module every action imports.
node_test(
    name = "helpers_test",
    size = "small",
    srcs = ["lib/helpers.test.mjs"],
    data = [
        "lib/helpers.mjs",
        "lib/testing.mjs",
    ],
)

# bdd-sharded: the Cargo safety net's BDD suites as parallel processes. The
# tests start each fake suite as a Node process of its own.
node_test(
    name = "bdd_sharded_test",
    size = "small",
    srcs = ["bdd-sharded/bdd.test.mjs"],
    data = [
        "bdd-sharded/bdd.mjs",
        "lib/helpers.mjs",
        "lib/testing.mjs",
    ],
)

# bazel-coverage: the coverage job's `bazel coverage` run. The tests start a
# fake Bazel as a Node process of its own, and read .bazelrc for the configs.
node_test(
    name = "bazel_coverage_test",
    size = "small",
    srcs = ["bazel-coverage/coverage.test.mjs"],
    data = [
        "bazel-coverage/coverage.mjs",
        "lib/helpers.mjs",
        "//:.bazelrc",
    ],
)

# cargo-cache: the pool `stable / clippy`'s compiled dependencies, kept in the
# LAN bazel-remote. The tests that pack and unpack run on Linux only, where
# the action runs, with GNU tar (and zstd, where the machine has it).
node_test(
    name = "cargo_cache_test",
    size = "small",
    srcs = ["cargo-cache/cache.test.mjs"],
    data = [
        "cargo-cache/cache.mjs",
        "lib/helpers.mjs",
        "lib/testing.mjs",
    ],
)

# The module every install-* action downloads, checks and unpacks with. Each OS
# leg unpacks the archive formats its own assets come in, with its own tools:
# GNU tar and unzip on Linux, bsdtar on macOS and Windows.
node_test(
    name = "install_test",
    size = "small",
    srcs = ["lib/install.test.mjs"],
    data = [
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# install-omnisim: the ASCOM Alpaca simulators rp's BDD scenarios spawn.
node_test(
    name = "install_omnisim_test",
    size = "small",
    srcs = ["install-omnisim/omnisim.test.mjs"],
    data = [
        "install-omnisim/omnisim.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# install-pebble: Pebble and pebble-challtestsrv, for doctor's @pebble BDD
# scenarios.
node_test(
    name = "install_pebble_test",
    size = "small",
    srcs = ["install-pebble/pebble.test.mjs"],
    data = [
        "install-pebble/pebble.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# install-astap: the ASTAP CLI and its D05 star database from SourceForge, and
# the table of pins refresh-astap rewrites.
node_test(
    name = "install_astap_test",
    size = "small",
    srcs = ["install-astap/astap.test.mjs"],
    data = [
        "install-astap/assets.json",
        "install-astap/astap.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# refresh-astap: refresh-astap-shas.yml's refresh of install-astap's pins. The
# tests start a fake ASTAP as a Node process in the binary's place, and read
# the .wcs the real one wrote, and the title install-astap.yml gives its
# tracking issue, which the refresh comments on.
node_test(
    name = "refresh_astap_test",
    size = "small",
    srcs = [
        "refresh-astap/detect.test.mjs",
        "refresh-astap/publish.test.mjs",
    ],
    data = [
        "install-astap/assets.json",
        "install-astap/astap.mjs",
        "lib/github.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
        "refresh-astap/detect.mjs",
        "refresh-astap/publish.mjs",
        "refresh-astap/testdata/m101_known.wcs",
        "tracking-issue/issue.mjs",
        "//:.github/workflows/install-astap.yml",
    ],
)

# install-svbony-sdk: SVBony's camera SDK, which libsvbony-sys links: from the
# INDI repository at a commit on Linux and macOS, from the project's private
# mirror on Windows.
node_test(
    name = "install_svbony_sdk_test",
    size = "small",
    srcs = ["install-svbony-sdk/svbony-sdk.test.mjs"],
    data = [
        "install-svbony-sdk/svbony-sdk.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# install-zwo-sdk: ZWO's ASI, EFW and EAF SDKs, which libzwo-sys links: from the
# INDI repository at a commit on Linux and macOS, from ZWO's CDN on Windows.
# Medium: on Windows each install's unpacking starts PowerShell twice, a second
# or more each.
node_test(
    name = "install_zwo_sdk_test",
    size = "medium",
    srcs = ["install-zwo-sdk/zwo-sdk.test.mjs"],
    data = [
        "install-zwo-sdk/zwo-sdk.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# A developer's install of a tool CI installs, by the install-* action's own
# module: `bazel run //.github/actions:install -- <tool> [--prefix DIR]`.
node_binary(
    name = "install",
    src = "local-install/index.mjs",
    data = [
        "install-astap/assets.json",
        "install-astap/astap.mjs",
        "install-omnisim/omnisim.mjs",
        "install-pebble/pebble.mjs",
        "install-svbony-sdk/svbony-sdk.mjs",
        "install-zwo-sdk/zwo-sdk.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "local-install/local.mjs",
    ],
)

# The install's command line, and its launcher, run as `bazel run` runs it.
# What the test imports beyond lib/testing.mjs comes from :install's runfiles
# alone, so a file :install lacks fails the test as it would fail `bazel run`.
node_test(
    name = "local_install_test",
    size = "small",
    srcs = ["local-install/local.test.mjs"],
    data = [
        "lib/testing.mjs",
        ":install",
    ],
)

# lan-crates: the pool `stable / clippy`'s crates from the LAN bazel-remote.
# Reads the repository's own Cargo.lock too: a format Cargo starts to write
# that the action cannot read fails here, where on the runner it would only
# be a warning, and Cargo would quietly go back to downloading every crate.
node_test(
    name = "lan_crates_test",
    size = "small",
    srcs = [
        "lan-crates/crates.test.mjs",
        "lan-crates/untar.test.mjs",
    ],
    data = [
        "lan-crates/crates.mjs",
        "lan-crates/fixtures.mjs",
        "lan-crates/untar.mjs",
        "lib/helpers.mjs",
        "lib/testing.mjs",
        "//:Cargo.lock",
    ],
)

# remote-cache: the Bazel steps' remote cache for the job's venue, and the
# credential helper that gives Bazel its write credential. The tests run the
# helper as Bazel does, and read the cache .bazelrc's remote-cache config names
# and the file .bazelrc imports.
node_test(
    name = "remote_cache_test",
    size = "small",
    srcs = ["remote-cache/remote.test.mjs"],
    data = [
        "lib/helpers.mjs",
        "lib/testing.mjs",
        "remote-cache/helper.mjs",
        "remote-cache/remote.mjs",
        "//:.bazelrc",
    ],
)

# tracking-issue: a scheduled workflow's tracking issue, opened or commented on
# when a scheduled run fails.
node_test(
    name = "tracking_issue_test",
    size = "small",
    srcs = ["tracking-issue/issue.test.mjs"],
    data = [
        "lib/github.mjs",
        "lib/helpers.mjs",
        "lib/testing.mjs",
        "tracking-issue/issue.mjs",
    ],
)

# uncovered-diff-lines: the coverage job's check on a pull request, posted by
# the coverage scripts' poster, which the action runs from the checkout. The
# tests start a fake in each program's place as a Node process of its own,
# and answer as the GitHub API does. On Linux they also run the poster
# itself, with the host's python3.
node_test(
    name = "uncovered_diff_lines_test",
    size = "small",
    srcs = ["uncovered-diff-lines/annotate.test.mjs"],
    data = [
        "lib/github.mjs",
        "lib/helpers.mjs",
        "lib/testing.mjs",
        "uncovered-diff-lines/annotate.mjs",
        "//:tools/coverage/filter_lcov.py",
        "//:tools/coverage/post_check_annotations.py",
    ],
)

# Every JavaScript file in this package parses, and its imports resolve to a
# Node built-in or a file here, with the names it imports: entry files
# included, which no test imports, since they run on load.
node_link_test(
    name = "link_test",
    size = "small",
    src = "link.test.mjs",
)
