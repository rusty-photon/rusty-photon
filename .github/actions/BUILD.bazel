# Tests of the CI's local JavaScript actions (ADR-022), run by `bazel test
# //...` on every OS leg, on the Node that MODULE.bazel pins.
#
# One package holds everything under .github/actions: an action's directory
# gets no BUILD file of its own, and its tests are declared here, so that
# `link_test` covers every file (node_link_test refuses a BUILD file below
# this one). Conventions: docs/skills/ci-logic.md.

load(":node_test.bzl", "node_binary", "node_link_test", "node_test")

# The helper module every action imports.
node_test(
    name = "helpers_test",
    size = "small",
    srcs = ["lib/helpers.test.mjs"],
    data = [
        "lib/helpers.mjs",
        "lib/testing.mjs",
    ],
)

# cargo-cache: the pool `stable / clippy`'s compiled dependencies, kept in the
# LAN bazel-remote. The tests that pack and unpack run on Linux only, where
# the action runs, with GNU tar (and zstd, where the machine has it).
node_test(
    name = "cargo_cache_test",
    size = "small",
    srcs = ["cargo-cache/cache.test.mjs"],
    data = [
        "cargo-cache/cache.mjs",
        "lib/helpers.mjs",
        "lib/testing.mjs",
    ],
)

# The module every install-* action downloads, checks and unpacks with. Each OS
# leg unpacks the archive formats its own assets come in, with its own tools:
# GNU tar and unzip on Linux, bsdtar on macOS and Windows.
node_test(
    name = "install_test",
    size = "small",
    srcs = ["lib/install.test.mjs"],
    data = [
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# install-omnisim: the ASCOM Alpaca simulators rp's BDD scenarios spawn.
node_test(
    name = "install_omnisim_test",
    size = "small",
    srcs = ["install-omnisim/omnisim.test.mjs"],
    data = [
        "install-omnisim/omnisim.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# install-pebble: Pebble and pebble-challtestsrv, for doctor's @pebble BDD
# scenarios.
node_test(
    name = "install_pebble_test",
    size = "small",
    srcs = ["install-pebble/pebble.test.mjs"],
    data = [
        "install-pebble/pebble.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# install-astap: the ASTAP CLI and its D05 star database from SourceForge, and
# the table of pins refresh-astap-shas.yml reads and rewrites.
node_test(
    name = "install_astap_test",
    size = "small",
    srcs = ["install-astap/astap.test.mjs"],
    data = [
        "install-astap/assets.json",
        "install-astap/astap.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
    ],
)

# A developer's install of a tool CI installs, by the install-* action's own
# module: `bazel run //.github/actions:install -- <tool> [--prefix DIR]`.
node_binary(
    name = "install",
    src = "local-install/index.mjs",
    data = [
        "install-omnisim/omnisim.mjs",
        "install-pebble/pebble.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "local-install/local.mjs",
    ],
)

# The install's command line, and its launcher, run as `bazel run` runs it.
node_test(
    name = "local_install_test",
    size = "small",
    srcs = ["local-install/local.test.mjs"],
    data = [
        "install-omnisim/omnisim.mjs",
        "install-pebble/pebble.mjs",
        "lib/helpers.mjs",
        "lib/install.mjs",
        "lib/testing.mjs",
        "local-install/local.mjs",
        ":install",
    ],
)

# lan-crates: the pool `stable / clippy`'s crates from the LAN bazel-remote.
# Reads the repository's own Cargo.lock too: a format Cargo starts to write
# that the action cannot read fails here, where on the runner it would only
# be a warning, and Cargo would quietly go back to downloading every crate.
node_test(
    name = "lan_crates_test",
    size = "small",
    srcs = [
        "lan-crates/crates.test.mjs",
        "lan-crates/untar.test.mjs",
    ],
    data = [
        "lan-crates/crates.mjs",
        "lan-crates/fixtures.mjs",
        "lan-crates/untar.mjs",
        "lib/helpers.mjs",
        "lib/testing.mjs",
        "//:Cargo.lock",
    ],
)

# tracking-issue: a scheduled workflow's tracking issue, opened or commented on
# when a scheduled run fails.
node_test(
    name = "tracking_issue_test",
    size = "small",
    srcs = ["tracking-issue/issue.test.mjs"],
    data = [
        "lib/helpers.mjs",
        "lib/testing.mjs",
        "tracking-issue/issue.mjs",
    ],
)

# Every JavaScript file in this package parses, and its imports resolve to a
# Node built-in or a file here, with the names it imports: entry files
# included, which no test imports, since they run on load.
node_link_test(
    name = "link_test",
    size = "small",
    src = "link.test.mjs",
)
