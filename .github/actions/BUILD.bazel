# Tests of the CI's local JavaScript actions (ADR-022), run by `bazel test
# //...` on every OS leg, on the Node that MODULE.bazel pins.
#
# One package holds everything under .github/actions: an action's directory
# gets no BUILD file of its own, and its tests are declared here, so that
# `link_test` covers every file (node_link_test refuses a BUILD file below
# this one). Conventions: docs/skills/ci-logic.md.

load(":node_test.bzl", "node_binary", "node_link_test", "node_test")

# The helper module every action imports.
node_test(
    name = "helpers_test",
    size = "small",
    srcs = ["lib/helpers.test.mjs"],
    data = [
        "lib/helpers.mjs",
        "lib/testing.mjs",
    ],
)

# The programs run at once that bdd-sharded and conformu-run share. The tests
# start each fake program as a Node process of its own.
node_test(
    name = "processes_test",
    size = "small",
    srcs = ["lib/processes.test.mjs"],
    data = [
        "lib/helpers.mjs",
        "lib/processes.mjs",
        "lib/testing.mjs",
    ],
)

# bdd-sharded: the Cargo safety net's BDD suites as parallel processes. The
# tests start each fake suite as a Node process of its own.
node_test(
    name = "bdd_sharded_test",
    size = "small",
    srcs = ["bdd-sharded/bdd.test.mjs"],
    data = [
        "bdd-sharded/bdd.mjs",
        "lib/helpers.mjs",
        "lib/processes.mjs",
        "lib/testing.mjs",
    ],
)

# conformu-run: conformu.yml's ConformU suites at once, on Linux and macOS.
# The tests start a fake in cargo's place.
node_test(
    name = "conformu_run_test",
    size = "small",
    srcs = ["conformu-run/run.test.mjs"],
    data = [
        "conformu-run/run.mjs",
        "lib/helpers.mjs",
        "lib/processes.mjs",
        "lib/testing.mjs",
    ],
)

