# pool_routing.rs reads the workflows and actionlint's runner labels,
# toolchain_pins.rs MODULE.bazel and the root Cargo.toml, and pkg_assets.rs the
# packaging files, among them doctor's Cargo.toml: doctor has no package of its
# own, it ships in sentinel's. bare_refs.rs reads every member's sources, the
# root's own files, the workflows and the local actions'. Cargo sets
# CARGO_MANIFEST_DIR when it runs a test; here it is relative to the runfiles
# root the test starts in. rust_toolchain_sha256s.rs's tests `include_str!` the
# saved channel manifests in testdata/.
rust_test(
    name = "rusty-photon-ci_unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    compile_data = glob(["testdata/**"]),
    crate = ":rusty-photon-ci_lib",
    data = [
        "//:.bazelrc",
        "//:.github/actionlint.yaml",
        "//:Cargo.toml",
        "//:MODULE.bazel",
        "//.github/actions:install-svbony-sdk/svbony-sdk.mjs",
        "//.github/actions:install-zwo-sdk/zwo-sdk.mjs",
        "//.github/actions:sources",
        "//:packaging_files",
        "//:workflows",
        "//crates/qhyccd-rs/libqhyccd-sys:build.rs",
        "//crates/zwo-rs/libzwo-sys:sdk/include/license.txt",
        "//services/doctor:Cargo.toml",
        "//services/qhy-camera:src/preflight.rs",
    ] + ["//services/%s:Cargo.toml" % service for service in _SERVICES] + [
        "//services/%s:pkg" % service
        for service in _SERVICES
    ] + ["//%s:sources" % member for member in _MEMBERS],
    env = {"CARGO_MANIFEST_DIR": "tools/rusty-photon-ci"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The files the tools crate's bare-reference guard reads
# (tools/rusty-photon-ci/src/bare_refs.rs).
filegroup(
    name = "sources",
    srcs = glob(
        [
            "**/*.rs",
            "**/*.feature",
            "**/*.toml",
        ],
        allow_empty = True,
    ),
    visibility = ["//tools/rusty-photon-ci:__pkg__"],
)
