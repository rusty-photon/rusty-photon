load("@cr//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "rusty-photon-ci_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    crate_name = "rusty_photon_ci",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

# Developers run it through Cargo (`cargo ci <tool>`, .cargo/config.toml);
# Bazel builds it so the build covers it like any crate.
rust_binary(
    name = "rusty-photon-ci",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":rusty-photon-ci_lib"] + all_crate_deps(normal = True),
)

# pool_routing.rs reads the workflows and actionlint's runner labels, and
# toolchain_pins.rs MODULE.bazel and the root Cargo.toml. Cargo sets
# CARGO_MANIFEST_DIR when it runs a test; here it is relative to the runfiles
# root the test starts in. rust_toolchain_sha256s.rs's tests `include_str!` the
# saved channel manifests in testdata/.
rust_test(
    name = "rusty-photon-ci_unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    compile_data = glob(["testdata/**"]),
    crate = ":rusty-photon-ci_lib",
    data = [
        "//:.github/actionlint.yaml",
        "//:Cargo.toml",
        "//:MODULE.bazel",
        "//:workflows",
    ],
    env = {"CARGO_MANIFEST_DIR": "tools/rusty-photon-ci"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
