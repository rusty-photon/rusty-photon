# Tests for the shell that runs on the Proxmox runner-pool hypervisor: the
# pool orchestrator, and the In-Band ECC watch that runs beside it.
#
# The scripts themselves are not built by Bazel — they are deployed to the
# hypervisor by hand and run there under systemd, so there is nothing to
# compile. What Bazel provides is the thing they were missing: a place for
# their tests to run on every change, in `bazel test //...`, rather than in an
# operator's scratch directory.
#
# Each harness takes the script under test as its one argument, so nothing
# hard-codes a path and `$(location)` keeps them working under the sandbox.
# No Proxmox host is involved, and no particular hardware either, which is why
# these can be ordinary `sh_test`s that anyone can run: every command that
# would reach infrastructure (`qm`, `pvesm`, `curl`, `logger`, ...) is stubbed
# inside the harness, and every filesystem the script reads is a tmpdir
# supplied through an override — `PVE_CONF_ROOT` for the pool, `RP_EDAC_ROOT`
# and `RP_EDAC_STATE_DIR` for the ECC watch. They must never grow a fallback
# that shells out to a real `qm`, `pvesm`, or `/sys`.
#
# *Every* external command is not stubbed, though, and calling these hermetic
# without that qualification would be wrong. Ordinary utilities used for
# computation stay real, because stubbing them would mean testing the stub
# rather than the code: the pool harnesses let `find` and `awk` run, and the
# ECC harness lets `realpath` run. That last one is load-bearing enough to
# check — its comparisons are meaningless without `realpath -m`, which busybox
# does not provide — so the harness asserts it up front instead of letting two
# dozen cases fail with a message about something else.
#
# One test per behaviour group rather than one runner over all of them, so a
# failure names the function whose contract broke rather than "the runner-pool
# tests failed".
#
# Linux-only, and that is about the subject rather than the harness: this
# script runs as root on a Debian hypervisor and is not deployed anywhere else,
# so its POSIX-mode and `chmod`-based cases describe behaviour Windows does not
# have. Bazel skips them there as incompatible rather than failing, which is
# the honest outcome — a green Windows run that silently did not exercise them
# would be worse.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "rp-edac-check.sh",
    "rp-runner-pool.sh",
])

# free_leaked_volume: is a volume's absence established, or merely assumed?
# Plus the ownership recheck that guards every retry inside it.
sh_test(
    name = "runner_pool_free_test",
    size = "small",
    srcs = ["tests/test-free.sh"],
    args = ["$(location rp-runner-pool.sh)"],
    data = ["rp-runner-pool.sh"],
    target_compatible_with = ["@platforms//os:linux"],
)

# sweep_orphan_volumes: this one DELETES storage, so the cases that matter most
# are the ones where it must refuse.
sh_test(
    name = "runner_pool_sweep_test",
    size = "small",
    srcs = ["tests/test-sweep.sh"],
    args = ["$(location rp-runner-pool.sh)"],
    data = ["rp-runner-pool.sh"],
    target_compatible_with = ["@platforms//os:linux"],
)

# destroy_clone: which runner gets deregistered, and whether the caller is told
# the truth about the VM being gone.
sh_test(
    name = "runner_pool_destroy_test",
    size = "small",
    srcs = ["tests/test-destroy.sh"],
    args = ["$(location rp-runner-pool.sh)"],
    data = ["rp-runner-pool.sh"],
    target_compatible_with = ["@platforms//os:linux"],
)

# rp-edac-check: a monitor whose every interesting branch needs unhappy
# hardware, so the fixtures are the only way any of them ever executes. The
# identity cases matter as much as the counter ones — a test run that logs
# under the production tag fabricates the evidence this check exists to
# provide honestly, and nothing about a healthy host would contradict it.
sh_test(
    name = "edac_check_test",
    size = "small",
    srcs = ["tests/test-edac.sh"],
    args = ["$(location rp-edac-check.sh)"],
    data = ["rp-edac-check.sh"],
    target_compatible_with = ["@platforms//os:linux"],
)

# The busy-check the runbook tells an operator to paste before `qm stop`.
# Executable documentation, so it is tested like code. It reads no script, but
# takes the same argument so every harness here is invoked identically.
sh_test(
    name = "runner_pool_runbook_busycheck_test",
    size = "small",
    srcs = ["tests/test-runbook-busycheck.sh"],
    args = ["$(location rp-runner-pool.sh)"],
    data = ["rp-runner-pool.sh"],
    target_compatible_with = ["@platforms//os:linux"],
)
